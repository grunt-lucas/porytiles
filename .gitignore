# IDE and filesystem metadata
.vscode/*
!.vscode/c_cpp_properties.json
!.vscode/launch.json
.idea/*
!.idea/cmake.xml
.DS_Store
.claude/settings.local.json

# Build artifacts and executables
build/**
porytiles-build-*/**

# Doxygen: ignore the build artifacts. They change frequently.
Documentation/html/**
Documentation/latex/**

# LLVM coverage files
default.profraw
testcov.profdata
*-coverage/**

# I often throw tmp test files in directories foo, bar, etc
foo/**
bar/**
tmp/**

# Ignore Python venv
venv/**
.venv/**

# Ignore porytiles docs projects
porytiles-user-docs
porytiles-dev-docs

