{
  "configurations": [
    {
      "name": "Mac",
      "includePath": [
        "${workspaceFolder}/legacy/include/**",
        "${workspaceFolder}/legacy/lib/**",
        "${workspaceFolder}/legacy/tools/**",
        "${workspaceFolder}/legacy/vendor/**",
        "${workspaceFolder}/porytiles/include/**",
        "${workspaceFolder}/porytiles/lib/**",
        "${workspaceFolder}/porytiles/tools/**",
        "${workspaceFolder}/porytiles-build-debug/_deps/fmt-src/include/**",
        "${workspaceFolder}/porytiles-build-debug/_deps/cli11_proj-src/include/**",
        "${workspaceFolder}/porytiles-build-debug/_deps/gsl-src/include/**",
        "${workspaceFolder}/porytiles-build-debug/_deps/googletest-src/googletest/include/**",
        "${workspaceFolder}/porytiles-build-debug/_deps/pngpp-src/include/**",
        "${workspaceFolder}/porytiles-build-debug/_deps/json-src/include/**",
        "${workspaceFolder}/porytiles-build-debug/_deps/yaml-cpp-src/include/**",
        "${workspaceFolder}/porytiles-build-debug/_deps/fruit-src/include/**",
        "${workspaceFolder}/porytiles-build-debug/_deps/fruit-build/include/**",
        "${workspaceFolder}/porytiles-build-debug/_deps/fruit-build/include/**",
        "${workspaceFolder}/porytiles-build-debug/_deps/cpptrace-src/include/**",
        "/opt/homebrew/opt/libpng/include/**"
      ],
      "defines": [
        "cimg_display=0"
      ],
      "macFrameworkPath": [
        "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks"
      ],
      "cppStandard": "c++23",
      "intelliSenseMode": "macos-clang-arm64",
      "configurationProvider": "ms-vscode.makefile-tools"
    }
  ],
  "version": 4
}
