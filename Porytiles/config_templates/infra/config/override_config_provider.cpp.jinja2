namespace porytiles {

OverrideConfigProvider::OverrideConfigProvider(
    ConfigScopeType scope_type, std::string scope, std::string source_info)
    : scope_type_{scope_type}, scope_{std::move(scope)}, source_info_{std::move(source_info)}
{
}

std::string OverrideConfigProvider::name() const
{
    return "OverrideConfigProvider(" + source_info_ + ")";
}

bool OverrideConfigProvider::scope_matches(ConfigScopeType type, const std::string &scope) const
{
    return type == scope_type_ && scope == scope_;
}
{% for value in config_values %}

void OverrideConfigProvider::set_{{ value.symbol }}({{ value.type }} value)
{
    {{ value.symbol }}_override_ = std::move(value);
}
{% endfor %}
{% for value in config_values %}

LayerValue<{{ value.type }}>
OverrideConfigProvider::{{ value.symbol }}(ConfigScopeType type, const std::string &scope) const
{
    if (!scope_matches(type, scope) || !{{ value.symbol }}_override_.has_value()) {
        return LayerValue<{{ value.type }}>::not_provided();
    }
    return LayerValue<{{ value.type }}>::valid(
        {{ value.symbol }}_override_.value(), "{{ value.symbol }}", source_info_);
}
{% endfor %}

} // namespace porytiles
