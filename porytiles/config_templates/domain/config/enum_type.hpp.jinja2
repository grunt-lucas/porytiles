{#
  Template for generating enum type headers

  This template generates a complete enum header file including:
  - Enum class definition with documented values
  - *_from_str() function that parses strings to enum values with fuzzy matching
  - to_string() function that converts enum values to canonical name strings (snake_case)
  - ostream operator<< for easy printing

  Template variables:
    enum: The enum definition from config_schema.yaml with:
      - cpp_type: The C++ enum class name
      - brief: Brief description for Doxygen
      - details: (optional) Detailed description for Doxygen
      - values: List of enum values, each with:
        - name: C++ enum constant name (snake_case)
        - fuzzy_names: List of acceptable string representations for fuzzy matching
        - brief: Brief description for this value
#}
{% import '_macros.jinja2' as macros %}
#pragma once

#include <algorithm>
#include <cctype>
#include <format>
#include <optional>
#include <ostream>
#include <string>

#include "porytiles/utilities/panic/panic.hpp"

{{ macros.autogen_warning() }}

namespace porytiles {

/**
 * @brief {{ enum.brief }}
 *
 * @details
{% for line in (enum.details | default(enum.brief)).split('\n') %}
 * {{ line | trim }}
{% endfor %}
 */
enum class {{ enum.cpp_type }} {
{% for val in enum.enum_values %}
    /**
     * @brief {{ val.brief }}
     */
    {{ val.name }}{% if not loop.last %},{% endif %}

{% endfor %}
};

/**
 * @brief Parses a string into a {{ enum.cpp_type }} with fuzzy matching.
 *
 * @details
 * Performs parsing in two phases:
 * 1. Exact match against C++ constant names (snake_case)
 * 2. Case-insensitive fuzzy match against configured fuzzy_names
 *
 * This unified function is used by both CLI and YAML parsing. The fuzzy matching
 * allows users to use various common formats (kebab-case, snake_case, etc.) while
 * still getting good error messages through LazyLayeredConfig.
 *
 * @param str The string to parse
 * @return The parsed value, or std::nullopt if the string is invalid
 */
[[nodiscard]] inline std::optional<{{ enum.cpp_type }}> {{ enum.cpp_type | snake_case }}_from_str(const std::string &str)
{
    // Phase 1: Exact match against C++ constant names
{% for val in enum.enum_values %}
    if (str == "{{ val.name }}") {
        return std::optional{ {{ enum.cpp_type }}::{{ val.name }} };
    }
{% endfor %}

    // Phase 2: Case-insensitive fuzzy match
    std::string lower_str = str;
    std::ranges::transform(
            lower_str, lower_str.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });

{% for val in enum.enum_values %}
{% if val.fuzzy_names %}
    // Fuzzy names for {{ val.name }}
{% for fuzzy in val.fuzzy_names %}
    if (lower_str == "{{ fuzzy | lower }}") {
        return std::optional{ {{ enum.cpp_type }}::{{ val.name }} };
    }
{% endfor %}
{% endif %}
{% endfor %}

    return std::nullopt;
}

/**
 * @brief Converts a {{ enum.cpp_type }} to its canonical string representation.
 *
 * @details
 * Returns the C++ constant name (snake_case). This is the canonical form used for
 * general purpose string conversion, logging, and error messages.
 *
 * @param m The value to convert
 * @return The canonical snake_case string representation
 */
[[nodiscard]] inline std::string to_string(const {{ enum.cpp_type }} m)
{
    switch (m) {
{% for val in enum.enum_values %}
    case {{ enum.cpp_type }}::{{ val.name }}:
        return "{{ val.name }}";
{% endfor %}
    }
    panic("unhandled {{ enum.cpp_type }} value");
}

/**
 * @brief Stream insertion operator for {{ enum.cpp_type }}.
 *
 * @param os The output stream
 * @param m The value to output
 * @return Reference to the output stream
 */
inline std::ostream &operator<<(std::ostream &os, const {{ enum.cpp_type }} m)
{
    return os << to_string(m);
}

} // namespace porytiles

template <>
struct std::formatter<porytiles::{{ enum.cpp_type }}> {
    constexpr auto parse(std::format_parse_context &ctx)
    {
        return ctx.begin();
    }

    auto format(const porytiles::{{ enum.cpp_type }} &value, auto &ctx) const
    {
        return std::format_to(ctx.out(), "{}", porytiles::to_string(value));
    }
};
