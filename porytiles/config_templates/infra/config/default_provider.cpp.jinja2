{% import '_macros.jinja2' as macros %}
#include "porytiles/infra/config/default_provider.hpp"

{{ macros.autogen_warning() }}

namespace {

const std::string source_info = "default value";

}

namespace porytiles {

std::string DefaultProvider::name() const
{
