{#
  Template for generating cli_option_registration.cpp

  This template generates the implementation for registering CLI options with CLI11.
  All types are captured as strings and stored in CliOptionStorage. Type parsing is
  deferred to CliOptionProvider for consistent error handling via LayerValue.

  Type handling:
  - bool: add_flag() with callback storing "true"/"false" string
  - std::size_t/std::string/Rgba32: add_option() storing raw string directly
  - std::optional<T>: same as T. An unset optional means "no source pinned this value", which is
    the absence of the flag, so there is nothing extra to register.
  - Enums: add_option() storing raw string (already was this way)

  Every type dispatched on below must also appear in CLI_HANDLED_TYPES in scripts/generate_config.py,
  which fails generation if a schema entry declares a cli_option this chain would silently skip.
#}
{% import '_macros.jinja2' as macros %}
#include "porytiles/infra/cli/cli_option_registration.hpp"

#include <string>

{{ macros.autogen_warning() }}

namespace porytiles {

void register_config_options(CLI::App &app, CliOptionStorage &storage)
{
    auto *config_group = app.add_option_group("Config Options", "Override configuration values");
    config_group->footer("");  // Clear inherited footer to prevent duplication in help output

{% for value in config_values if not value.yaml_only %}
{% if value.type == 'bool' %}
    // {{ value.canonical_name }} (bool with --flag/--no-flag, captured as "true"/"false" string)
    config_group->add_flag(
        "--{{ value.cli_option }},!--no-{{ value.cli_option }}",
        [&storage](std::int64_t count) {
            if (count > 0) {
                storage.{{ value.symbol }} = "true";
            }
            else if (count < 0) {
                storage.{{ value.symbol }} = "false";
            }
            // count == 0 means neither flag was provided, leave optional empty
        },
        "{{ value.canonical_name }}{% if value.cli_desc %} - {{ value.cli_desc }}{% endif %}");

{% elif value.type == 'std::vector<std::string>' %}
    // {{ value.canonical_name }} (std::vector<std::string>, multi-value)
    config_group->add_option(
        "--{{ value.cli_option }}",
        storage.{{ value.symbol }},
        "{{ value.canonical_name }}{% if value.cli_desc %} - {{ value.cli_desc }}{% endif %}");

{% elif value.type == 'std::size_t' %}
    // {{ value.canonical_name }} (std::size_t, captured as string, parsed by CliOptionProvider)
    config_group->add_option(
        "--{{ value.cli_option }}",
        storage.{{ value.symbol }},
        "{{ value.canonical_name }}{% if value.cli_desc %} - {{ value.cli_desc }}{% endif %}");

{% elif value.type == 'std::string' %}
    // {{ value.canonical_name }} (std::string)
    config_group->add_option(
        "--{{ value.cli_option }}",
        storage.{{ value.symbol }},
        "{{ value.canonical_name }}{% if value.cli_desc %} - {{ value.cli_desc }}{% endif %}");

{% elif value.type == 'std::optional<std::uint32_t>' %}
    // {{ value.canonical_name }} (optional mask, captured as string, parsed by CliOptionProvider)
    config_group->add_option(
        "--{{ value.cli_option }}",
        storage.{{ value.symbol }},
        "{{ value.canonical_name }}{% if value.cli_desc %} - {{ value.cli_desc }}{% endif %}");

{% elif value.type == 'std::optional<std::size_t>' %}
    // {{ value.canonical_name }} (optional std::size_t, captured as string, parsed by CliOptionProvider)
    config_group->add_option(
        "--{{ value.cli_option }}",
        storage.{{ value.symbol }},
        "{{ value.canonical_name }}{% if value.cli_desc %} - {{ value.cli_desc }}{% endif %}");

{% elif value.type == 'Rgba32' %}
    // {{ value.canonical_name }} (Rgba32, captured as string, parsed by CliOptionProvider)
    config_group->add_option(
        "--{{ value.cli_option }}",
        storage.{{ value.symbol }},
        "{{ value.canonical_name }}{% if value.cli_desc %} - {{ value.cli_desc }}{% endif %} (format: R,G,B or R,G,B,A, values 0-255)")
        ->type_name("R,G,B[,A]");

{% elif value.type in enum_type_map %}
{%   set enum_info = enum_type_map[value.type] %}
    // {{ value.canonical_name }} (enum {{ value.type }}, captured as string, parsed by CliOptionProvider)
    config_group->add_option(
        "--{{ value.cli_option }}",
        storage.{{ value.symbol }},
        "{{ value.canonical_name }}{% if value.cli_desc %} - {{ value.cli_desc }}{% endif %}")
        ->type_name("{{ enum_info.cli_type_name }}");

{% else %}
    // {{ value.canonical_name }} - type {{ value.type }} not handled, skipping
{% endif %}
{% endfor %}
}

} // namespace porytiles
