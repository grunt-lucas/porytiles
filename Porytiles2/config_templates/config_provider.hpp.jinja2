{% endfor %}

    /*
     * App Config
     */
{% for value in config_values if value.layer == 'app' %}

    [[nodiscard]] virtual LayerValue<{{ value.type }}> {{ value.name }}({% if value.scope_type == 'tileset' %}const std::string &tileset{% elif value.scope_type == 'layout' %}const std::string &layout{% endif %}) const;
{% endfor %}

    /*
     * Infra Config
     */
{% for value in config_values if value.layer == 'infra' %}
    [[nodiscard]] virtual LayerValue<{{ value.type }}> {{ value.name }}({% if value.scope_type == 'tileset' %}const std::string &tileset{% elif value.scope_type == 'layout' %}const std::string &layout{% endif %}) const;
{% endfor %}
};

