{#
  Template for generating cli_option_storage.hpp

  This template generates the CliOptionStorage struct that holds std::optional<std::string>
  for each config value that can be set via CLI. Values with cli_skip: true are excluded.

  All types are stored as raw strings. Type parsing is deferred to CliOptionProvider, which
  can return LayerValue::invalid() for proper error formatting through LazyLayeredConfig.
  This ensures uniform error messages across all CLI option types.
#}
{% import '_macros.jinja2' as macros %}
#pragma once

#include <optional>
#include <string>
#include <vector>

namespace porytiles2 {

{{ macros.autogen_warning() }}

/**
 * @brief Storage struct for CLI option values.
 *
 * @details
 * This struct holds std::optional<std::string> for each config value that can be set via CLI.
 * CLI11 populates these optionals when the corresponding command-line flags are provided.
 * Values that are too complex for CLI parsing (e.g., std::vector<PaletteHint>) are excluded.
 *
 * All types are stored as raw strings. Type parsing is deferred to CliOptionProvider so that
 * invalid values (for any type) can flow through the LayerValue system for consistent error
 * formatting. This ensures uniform error messages across all CLI option types.
 */
struct CliOptionStorage {
{% for value in config_values if not value.cli_skip %}
{% if value.type == 'std::vector<std::string>' %}
    std::vector<std::string> {{ value.symbol }};
{% else %}
    std::optional<std::string> {{ value.symbol }};
{% endif %}
{% endfor %}
};

} // namespace porytiles2
