namespace porytiles2 {

CliOptionProvider::CliOptionProvider(const CliOptionStorage &storage) : storage_{storage} {}

std::string CliOptionProvider::name() const
{
    return "CliOptionProvider";
}
{% for value in config_values %}

LayerValue<{{ value.type }}> CliOptionProvider::{{ value.symbol }}([[maybe_unused]] ConfigScopeType type, [[maybe_unused]] const std::string &scope) const
{
{% if value.yaml_only %}
    // Skipped for CLI (yaml_only: type too complex for non-YAML providers)
    return LayerValue<{{ value.type }}>::not_provided();
{% else %}
    // All types use parse functions for uniform error handling
    return {{ value.parser }}(storage_.{{ value.symbol }}, "--{{ value.cli_option }}");
{% endif %}
}
