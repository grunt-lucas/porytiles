ChainableResult<ConfigValue<{{ value.type }}>> LazyLayeredConfig::{{ value.symbol }}_raw(ConfigScopeType type, const std::string &scope) const
{
    const auto name = extract_function_name();
    // Strip the _raw suffix from the function name for cache key
    const auto base_name = name.substr(0, name.size() - 4);
    const auto key = to_string(type) + ":" + scope + ":" + base_name;
    return resolve_config_value<{{ value.type }}>(
        key, "{{ value.canonical_name }}", [&type, &scope](const ConfigProvider &provider) { return provider.{{ value.symbol }}(type, scope); });
}
