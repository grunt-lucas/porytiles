{#
  Template for generating app_config.hpp

  This template generates the AppConfig interface with virtual methods for
  configuration values defined in config_schema.yaml.
#}
{% import '_macros.jinja2' as macros %}
#pragma once

#include <string>

#include "porytiles2/app/config/incremental_build_mode.hpp"
#include "porytiles2/xcut/config/config_scope_type.hpp"
#include "porytiles2/xcut/config/config_value.hpp"
#include "porytiles2/xcut/config/config_validators.hpp"
#include "porytiles2/utilities/result/chainable_result.hpp"

namespace porytiles2 {

{{ macros.autogen_warning() }}

/**
 * @brief Interface that defines a complete app layer configuration.
 */
class AppConfig {
  public:
    virtual ~AppConfig() = default;
{% for value in config_values if value.layer == 'app' %}

    // Public method with cross-field validation only (Tier 3)
    [[nodiscard]] ChainableResult<ConfigValue<{{ value.type }}>>
    {{ value.name }}(ConfigScopeType type, const std::string &scope) const
    {
        auto validated_val = {{ value.name }}_validated(type, scope);
{% if value.cross_field_validators %}
        // Apply cross-field validators
{%   for cross_validator in value.cross_field_validators %}
{%     set validator_parts = cross_validator.split(':') %}
{%     set operator_name = validator_parts[0] %}
{%     set other_field_name = validator_parts[1] %}
        if (validated_val.has_value()) {
            validated_val = {{ operator_name }}<{{ value.type }}>(
                validated_val.value(), *this, type, scope, "{{ other_field_name }}",
                [](const AppConfig &cfg, ConfigScopeType t, const std::string &s) { return cfg.{{ other_field_name }}_validated(t, s); }
            );
        }
{%   endfor %}
{% endif %}
        return validated_val;
    }
{% endfor %}

  protected:
{% for value in config_values if value.layer == 'app' %}

    // Protected method with single-value validation only (Tier 2)
    [[nodiscard]] virtual ChainableResult<ConfigValue<{{ value.type }}>>
    {{ value.name }}_validated(ConfigScopeType type, const std::string &scope) const
    {
        auto raw_val = {{ value.name }}_raw(type, scope);
{% if value.validators %}
        // Apply validators in sequence
{%   for validator in value.validators %}
        if (raw_val.has_value()) {
            raw_val = {{ validator }}(raw_val.value());
        }
{%   endfor %}
{% endif %}
        return raw_val;
    }

    // Protected virtual method that fetches raw value from provider (Tier 1)
    [[nodiscard]] virtual ChainableResult<ConfigValue<{{ value.type }}>>
    {{ value.name }}_raw(ConfigScopeType type, const std::string &scope) const = 0;
{% endfor %}
};

} // namespace porytiles2
