{#
  Template for generating domain_config.hpp

  This template generates the DomainConfig interface with virtual methods for
  configuration values defined in config_schema.yaml.
#}
{% import '_macros.jinja2' as macros %}
#pragma once

#include <string>

#include "porytiles2/domain/models/rgba32.hpp"
#include "porytiles2/utilities/source_locations.hpp"
#include "porytiles2/utilities/text/plain_text_formatter.hpp"
#include "porytiles2/xcut/config/config_value.hpp"
#include "porytiles2/xcut/config/config_validators.hpp"
#include "porytiles2/utilities/panic/panic.hpp"
#include "porytiles2/utilities/result/chainable_result.hpp"

namespace porytiles2 {

{{ macros.autogen_warning() }}

/**
 * @brief Interface that defines a complete domain layer configuration.
 */
class DomainConfig {
  public:
    virtual ~DomainConfig() = default;

{% for value in config_values if value.layer == 'domain' %}
    // Public method with cross-field validation only (Tier 3)
    [[nodiscard]] ChainableResult<ConfigValue<{{ value.type }}>>
    {{ value.name }}({% if value.scope_type == 'tileset' %}const std::string &tileset{% elif value.scope_type == 'layout' %}const std::string &layout{% endif %}) const
    {
        auto validated_val = {{ value.name }}_validated({% if value.scope_type == 'tileset' %}tileset{% elif value.scope_type == 'layout' %}layout{% endif %});
{% if value.cross_field_validators %}
        // Apply cross-field validators
{%   for cross_validator in value.cross_field_validators %}
{%     if cross_validator.startswith('compare_') and ':' in cross_validator %}
{%       set validator_parts = cross_validator.split(':') %}
{%       set operator_name = validator_parts[0] %}
{%       set other_field_name = validator_parts[1] %}
        if (validated_val.has_value()) {
            validated_val = {{ operator_name }}<{{ value.type }}>(
                validated_val.value(), *this, {% if value.scope_type == 'tileset' %}tileset{% elif value.scope_type == 'layout' %}layout{% endif %}, "{{ other_field_name }}",
                [](const DomainConfig &cfg, const std::string &{% if value.scope_type == 'tileset' %}ts{% elif value.scope_type == 'layout' %}ly{% endif %}) { return cfg.{{ other_field_name }}_validated({% if value.scope_type == 'tileset' %}ts{% elif value.scope_type == 'layout' %}ly{% endif %}); }
            );
        }
{%     else %}
        // Custom cross-field validator
        if (validated_val.has_value()) {
            validated_val = {{ cross_validator }}(validated_val.value(), *this, {% if value.scope_type == 'tileset' %}tileset{% elif value.scope_type == 'layout' %}layout{% endif %});
        }
{%     endif %}
{%   endfor %}
{% endif %}
        return validated_val;
    }

{% endfor %}
  protected:
{% for value in config_values if value.layer == 'domain' %}
    // Protected method with single-value validation only (Tier 2)
    [[nodiscard]] virtual ChainableResult<ConfigValue<{{ value.type }}>>
    {{ value.name }}_validated({% if value.scope_type == 'tileset' %}const std::string &tileset{% elif value.scope_type == 'layout' %}const std::string &layout{% endif %}) const
    {
        auto raw_val = {{ value.name }}_raw({% if value.scope_type == 'tileset' %}tileset{% elif value.scope_type == 'layout' %}layout{% endif %});
{% if value.validators %}
        // Apply validators in sequence
{%   for validator in value.validators %}
        if (raw_val.has_value()) {
            raw_val = {{ validator }}(raw_val.value());
        }
{%   endfor %}
{% endif %}
        return raw_val;
    }

    // Protected virtual method that fetches raw value from provider (Tier 1)
    [[nodiscard]] virtual ChainableResult<ConfigValue<{{ value.type }}>>
    {{ value.name }}_raw({% if value.scope_type == 'tileset' %}const std::string &tileset{% elif value.scope_type == 'layout' %}const std::string &layout{% endif %}) const = 0;

{% endfor %}
};

} // namespace porytiles2
